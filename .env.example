# Copy this file to .env and fill in only the keys for the providers/models you plan to run.
# See config.py for the full LLM_PRESETS registry.

OPENAI_API_KEY=your_openai_key                    # openai_gpt4o
ANTHROPIC_API_KEY=your_anthropic_key              # anthropic_claude_sonnet46
GOOGLE_API_KEY=your_google_key                    # google_gemini25pro / google_gemini31pro
OPENROUTER_API_KEY=your_openrouter_key            # openrouter_*
SILICONFLOW_API_KEY=your_siliconflow_key          # siliconflow_*

# Optional: override the default LLM preset used when --model is not passed (default: openai_gpt4o)
# DECEPTION_LLM_PRESET=openai_gpt4o
